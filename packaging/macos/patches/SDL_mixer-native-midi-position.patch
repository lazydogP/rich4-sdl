+int native_midi_setposition(double position)
+{
+    int result = -1;
+    MusicTimeStamp beats;
+    MusicTimeStamp current;
+    if (currentsong == NULL || position < 0.0)
+        return -1;
+    SDL_PauseAudio(1);
+    SDL_UnlockAudio();
+    if (MusicSequenceGetBeatsForSeconds(
+            currentsong->sequence, position, &beats) == noErr &&
+        MusicPlayerSetTime(currentsong->player, beats) == noErr &&
+        MusicPlayerGetTime(currentsong->player, &current) == noErr &&
+        current >= beats - 0.1 && current <= beats + 0.1)
+        result = 0;
+    SDL_LockAudio();
+    SDL_PauseAudio(0);
+    return result;
+}
